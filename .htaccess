# ==========================================================================
# LP The Best School — configuração de servidor (Apache)
# Publicada em: https://profissionaissa.com.br/thebestschool/
#
# Este arquivo fica DENTRO da pasta /thebestschool e vale só para ela.
# Não mexe no resto do site profissionaissa.com.br.
# ==========================================================================

# --- Compressão --------------------------------------------------------
# Reduz o HTML de ~80 KB para ~15 KB na transferência.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache de navegador ------------------------------------------------
# Imagens e fontes ficam 1 ano em cache; o HTML nunca, para que uma
# alteração de texto apareça na hora.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType text/css          "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Segurança básica
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- MIME ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# --- Barra final (importante) -------------------------------------------
# A página usa caminhos relativos (assets/img/...). Sem a barra final, o
# navegador procuraria as imagens em /assets/ em vez de /thebestschool/assets/
# e tudo daria 404. Isto garante /thebestschool → /thebestschool/.
<IfModule mod_dir.c>
  DirectorySlash On
</IfModule>

# HTTPS e www são tratados pelo .htaccess da raiz do domínio — não repita
# aqui, para não criar redirecionamento duplo.

# --- Diretório ----------------------------------------------------------
DirectoryIndex index.html
Options -Indexes

# --- Bloqueio do que é só de trabalho -----------------------------------
# Vale quando a pasta do projeto é enviada inteira, em vez de apenas a dist/.
# Sem isto ficariam acessíveis: uma segunda cópia da página em /dist/, o
# arquivo de design do canvas (que abre quebrado e é indexável), 16 MB de
# material de referência em /uploads/ e o histórico do Git.

# Arquivos de projeto: documentação, scripts e o design do canvas
<FilesMatch "(\.(md|py|sh|json|dc\.html)|^support\.js|^\.DS_Store)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Pastas de trabalho
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(dist|uploads|_fotos-psa|\.git|\.claude)(/|$) - [F,L]
</IfModule>

# Reforço: sem os módulos acima, ao menos não indexa
<IfModule mod_headers.c>
  <FilesMatch "\.(md|py|sh|dc\.html)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
